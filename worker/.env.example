# Lista separada por vírgula de brokers Kafka (Redpanda local: localhost:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Credenciais SASL/PLAIN do broker gerenciado (produção). Deixe ambas em
# branco/ausentes para conectar em plaintext contra o Redpanda local.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Chave de API da Groq usada para gerar os treinos (movida do frontend para cá)
GROQ_API_KEY=

# Nome do tópico consumido (pedidos de geração de treino, produzidos pelo backend)
WORKOUT_GEN_REQUESTED_TOPIC=fitai.workout-generation-requested

# Nome do tópico produzido (resultado da geração, consumido pelo backend)
WORKOUT_GEN_RESULT_TOPIC=fitai.workout-generation-result

# Consumer group deste worker. Use um valor diferente em cada ambiente
# (local vs. produção) apontando pro mesmo broker gerenciado, para que uma
# instância local esquecida nunca roube mensagens de produção.
KAFKA_CONSUMER_GROUP=fitai-worker-workout-generation

# Porta do health check HTTP
PORT=8080
