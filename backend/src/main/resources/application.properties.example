
spring.application.name=fitai-backend
server.port=8081

# Banco de dados
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/fitai}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD}

# Flyway gerencia o schema — ddl-auto=validate apenas confere que o schema bate com as entidades
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true

# Flyway
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
# Deixe true se migrations de branches paralelas puderem chegar fora de ordem.
spring.flyway.out-of-order=${FLYWAY_OUT_OF_ORDER:true}

# JWT — gere uma chave segura com: openssl rand -base64 64
jwt.secret=${JWT_SECRET}
jwt.expiration=${JWT_EXPIRATION:86400000}
# Refresh token expira em 7 dias por padrão (604800000 ms)
jwt.refresh-expiration=${JWT_REFRESH_EXPIRATION:604800000}

# Google OAuth2 — obtenha em console.cloud.google.com
google.client-id=${GOOGLE_CLIENT_ID}

# CORS — origens permitidas separadas por vírgula
cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:3000,http://localhost:3001,http://localhost:3002,https://fit-ai-theta-eight.vercel.app}

# E-mail (reset de senha) — SendGrid (sendgrid.com), via API HTTPS.
# SMTP direto é bloqueado por várias plataformas de deploy (Railway incluída).
# sendgrid.from precisa ser um remetente verificado via Single Sender Verification.
sendgrid.api-key=${SENDGRID_API_KEY}
sendgrid.from=${SENDGRID_FROM}

# URL do frontend, usada para montar o link de redefinição de senha no e-mail
app.frontend-url=${FRONTEND_URL:http://localhost:3000}

# Kafka — broker gerenciado (ex: Confluent Cloud), publica eventos de auditoria.
# Deixe KAFKA_BOOTSTRAP_SERVERS vazio pra desativar (a publicação falha silenciosamente, só logada).
spring.kafka.bootstrap-servers=${KAFKA_BOOTSTRAP_SERVERS:}
spring.kafka.properties.security.protocol=SASL_SSL
spring.kafka.properties.sasl.mechanism=PLAIN
spring.kafka.properties.sasl.jaas.config=${KAFKA_SASL_JAAS_CONFIG:}
spring.kafka.producer.key-serializer=org.apache.kafka.common.serialization.StringSerializer
spring.kafka.producer.value-serializer=org.springframework.kafka.support.serializer.JsonSerializer
spring.kafka.producer.properties.spring.json.add.type.headers=false
app.kafka.audit-topic=${KAFKA_AUDIT_TOPIC:fitai.audit-events}
